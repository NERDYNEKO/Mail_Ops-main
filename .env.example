GMAIL_USER=mapster.officials@gmail.com
# Google Account > Security > 2 Step Verification > App passwords
GMAIL_APP_PASSWORD=
# Your own address, used only by "Send a test to myself" in the preview
TEST_EMAIL=
# Optional. Leave empty to write emails through your Claude Code login instead
ANTHROPIC_API_KEY=
DAILY_CAP=25
DELAY_MIN_SEC=90
DELAY_MAX_SEC=240
# days between the main mail and each follow up
FOLLOWUP_GAP_DAYS=2
# safety limit on follow ups per person (a reply stops them sooner)
FOLLOWUP_MAX=10
SEND_START_HOUR=9
SEND_END_HOUR=19
